diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index 06bb568..3dd372d 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1825,13 +1825,20 @@ init_ptpages(tt_entry_t *tt, vm_map_address_t start, vm_map_address_t end, bool
 #define ARM64_PHYSMAP_ALIGNMENT_PADDING (PTOV_TABLE_SIZE * ARM_TT_TWIG_SIZE)
 #endif
 
-#if defined(SWEET)
+#if defined(SWEET) || defined(FOGOS)
 /*
  * The reserved low-globals/kernel region is excluded from VM allocation.
  * Use the otherwise empty 32MB block above low globals and below gVirtBase
  * for a Normal-NC framebuffer alias that survives bootstrap TTBR0 teardown.
  */
 #define SWEET_EARLY_FB_VA (VM_MIN_KERNEL_ADDRESS + ARM_TT_L2_SIZE)
+#if defined(FOGOS)
+#define SWEET_EARLY_FB_BLOCK_PA 0x84000000ULL
+#define SWEET_EARLY_FB_OFFSET   0x01200000ULL
+#else
+#define SWEET_EARLY_FB_BLOCK_PA 0x9c000000ULL
+#define SWEET_EARLY_FB_OFFSET   0ULL
+#endif
 
 static void
 sweet_early_map_final(void)
@@ -1843,7 +1850,7 @@ sweet_early_map_final(void)
 	tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
 	tt_entry_t *slot = &l2[(va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
 	assert(*slot == ARM_TTE_EMPTY);
-	*slot = 0x9c000000ULL | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+	*slot = SWEET_EARLY_FB_BLOCK_PA | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
 	    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
 	    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
 	    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
@@ -2179,7 +2186,7 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 
 	arm_set_user_tbi();
 
-#if defined(SWEET)
+#if defined(SWEET) || defined(FOGOS)
 	/* phystokv() must still refer to the bootstrap aperture here. */
 	sweet_early_map_final();
 #endif
@@ -2188,9 +2195,9 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 
 	ml_enable_monitor();
 
-#if defined(SWEET)
+#if defined(SWEET) || defined(FOGOS)
 	/* The final TTBR1 is live; leave the outgoing VA=PA framebuffer alias. */
-	sweet_early_relocate(SWEET_EARLY_FB_VA);
+	sweet_early_relocate(SWEET_EARLY_FB_VA + SWEET_EARLY_FB_OFFSET);
 #endif
 	set_mmu_ttb(invalid_ttep & TTBR_BADDR_MASK);
 
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 777aca4..b1eefa2 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -480,6 +480,23 @@ Lsweet_mark_pixel:
 	subs	x2, x2, #1
 	b.ne	Lsweet_mark_row
 	dsb		sy
+#elif defined(FOGOS)
+	/* Visible marker at XNU entry; the shim paints the screen's top strip. */
+	MOV64	x0, (0x85200000 + 1568 * 2880)
+	mov		w1, #-1
+	mov		x2, #32
+	mov		x4, #2880
+Lfogos_mark_row:
+	mov		x3, #64
+	mov		x5, x0
+Lfogos_mark_pixel:
+	str		w1, [x5], #4
+	subs	x3, x3, #1
+	b.ne	Lfogos_mark_pixel
+	add		x0, x0, x4
+	subs	x2, x2, #1
+	b.ne	Lfogos_mark_row
+	dsb		sy
 #endif
 
 	// Set low reset vector before attempting any loads
@@ -643,6 +660,15 @@ Lkernelcache_base_found:
 	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
 	add		x13, x25, #(2 * PGBYTES)
 	str		x11, [x13, x12, lsl #TTE_SHIFT]
+#elif defined(FOGOS)
+	/* FOGOS splash region lies within the reserved 0x84000000 L2 block. */
+	MOV64	x10, 0x84000000
+	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
+	orr		x11, x11, x10
+	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
+	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
+	add		x13, x25, #(2 * PGBYTES)
+	str		x11, [x13, x12, lsl #TTE_SHIFT]
 #endif
 
 	/* Ensure TTEs are visible */
