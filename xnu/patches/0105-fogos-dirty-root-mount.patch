--- a/bsd/sweet_hfs/core/hfs_vfsutils.c
+++ b/bsd/sweet_hfs/core/hfs_vfsutils.c
@@ -202,20 +202,26 @@
 	/* don't mount a writable volume if its dirty, it must be cleaned by fsck_hfs */
 	if ((hfsmp->hfs_flags & HFS_READ_ONLY) == 0 && hfsmp->jnl == NULL &&
 	    (SWAP_BE32(vhp->attributes) & kHFSVolumeUnmountedMask) == 0) {
-#if defined(ARM64_BOARD_CONFIG_SWEET)
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_FOGOS)
 		/*
-		 * SWEET never unmounts its root (no clean shutdown yet), and
-		 * there is no fsck_hfs before the root mount: take it anyway.
+		 * SWEET/FOGOS never unmount their root (no clean shutdown yet),
+		 * and there is no fsck_hfs before the root mount: take it anyway.
+		 * The volume is marked dirty again on every read-write mount, so
+		 * after a hard reboot this is the normal state, not a fault.
 		 */
 		if (vfs_flags(hfsmp->hfs_mp) & MNT_ROOTFS) {
+#if defined(ARM64_BOARD_CONFIG_FOGOS)
+			printf("hfs_mounthfsplus: FOGOS: mounting dirty non-journaled root read-write\n");
+#else
 			printf("hfs_mounthfsplus: SWEET: mounting dirty non-journaled root read-write\n");
+#endif
 		} else {
 #endif
 		if (HFS_MOUNT_DEBUG) {
 			printf("hfs_mounthfsplus: cannot mount dirty non-journaled volumes\n");
 		}
 		return (EINVAL);
-#if defined(ARM64_BOARD_CONFIG_SWEET)
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_FOGOS)
 		}
 #endif
 	}
