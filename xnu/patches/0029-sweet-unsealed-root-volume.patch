diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -927,9 +927,24 @@
 		if (require_rootauth) {
 			/* enforce sealedness */
 			int autherr = VNOP_IOCTL(rootvnode, FSIOC_KERNEL_ROOTAUTH, NULL, 0, vfs_context_kernel());
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_FOGOS)
+			/*
+			 * These bring-up boards have no chain of trust to extend: the
+			 * kernel is booted unsigned without Image4/AMFI, and the HFS root
+			 * cannot be a sealed volume. Report it instead of panicking.
+			 */
+			if (autherr) {
+#if defined(ARM64_BOARD_CONFIG_FOGOS)
+				printf("FOGOS: root volume is not authenticated (error %d); continuing unsealed\n", autherr);
+#else
+				printf("SWEET: root volume is not authenticated (error %d); continuing unsealed\n", autherr);
+#endif
+			}
+#else
 			if (autherr) {
 				panic("rootvp not authenticated after mounting");
 			}
+#endif
 		}
 	}
 
