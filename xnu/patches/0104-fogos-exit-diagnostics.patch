+#if defined(ARM64_BOARD_CONFIG_FOGOS)
+	/*
+	 * Bring-up diagnostic: on FOGOS there is no working crash reporter or
+	 * syslog to inspect, so a daemon that dies just disappears from the
+	 * console (launchd only prints "Process(n) crashed: name"). Log every
+	 * non-init exit with the signal, exit status, code signing flags and
+	 * exit reason the kernel has, so crash loops can be diagnosed from the
+	 * serial console alone.
+	 */
+	if (p != initproc) {
+		if (p->p_exit_reason == OS_REASON_NULL) {
+			printf("FOGOS: pid %d (%s) exited: sig %d status %d cs 0x%x\n",
+			    proc_getpid(p), p->p_name, WTERMSIG(rv), WEXITSTATUS(rv),
+			    proc_getcsflags(p));
+		} else {
+			printf("FOGOS: pid %d (%s) exited: sig %d status %d cs 0x%x reason ns %d code 0x%llx\n",
+			    proc_getpid(p), p->p_name, WTERMSIG(rv), WEXITSTATUS(rv),
+			    proc_getcsflags(p), p->p_exit_reason->osr_namespace,
+			    p->p_exit_reason->osr_code);
+		}
+	}
+#endif
